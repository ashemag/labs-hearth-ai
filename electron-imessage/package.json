{
  "name": "hearth-imessage-sync",
  "version": "1.6.0",
  "description": "Sync iMessages to Hearth Rolodex",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:publish": "electron-builder --mac --publish always"
  },
  "author": "Hearth",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "dotenv": "^16.4.7",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sql.js": "^1.12.0"
  },
  "build": {
    "appId": "ai.hearth.app",
    "productName": "Hearth",
    "icon": "icon.icns",
    "protocols": {
      "name": "Hearth Sync Protocol",
      "schemes": ["hearth-sync"]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true
    },
    "publish": {
      "provider": "github",
      "owner": "ashemag",
      "repo": "hearth-imessage-sync",
      "releaseType": "release"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!scripts"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  }
}
