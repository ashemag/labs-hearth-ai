# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=

# Slack Integration
SLACK_CLIENT_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SerpAPI for LinkedIn/X enrichment
SERPAPI_KEY=

# Encryption key for API keys stored in Supabase (32 bytes hex)
ENCRYPTION_KEY=

# Google Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# OpenAI (for embeddings)
OPENAI_API_KEY=

# CORS (set to your Chrome extension origin in production)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Cron job authentication (required in production for calendar watch renewal)
CRON_SECRET=

# Development only
DEV_EMAIL=

# Optional: setup-db endpoint secret (required in production)
SETUP_DB_SECRET=

# Contentful CMS (optional, for blog)
NEXT_PUBLIC_GA_ID=
CONTENTFUL_SPACE_ID=
CONTENTFUL_MANAGEMENT_TOKEN=
